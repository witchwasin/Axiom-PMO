# ==========================
# OS Files
# ==========================
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# ==========================
# Editor / IDE
# ==========================
.vscode/
.idea/
*.swp
*.swo
*~

# ==========================
# Claude Code (local permissions — per-machine)
# ==========================
.claude/settings.local.json

# Codex local support files
.agents/

# ==========================
# Word / Excel / PowerPoint Temp & Lock Files
# ==========================
~$*.docx
~$*.doc
~$*.xlsx
~$*.xls
~$*.pptx
~$*.ppt
.~lock.*#

# ==========================
# FUSE Hidden Files
# ==========================
.fuse_hidden*

# ==========================
# Node.js / JavaScript
# ==========================
node_modules/
.next/
build/

# dist/ is the committed, dependency-free runtime bundle (DEC-026 §3). It must
# be tracked, not ignored: both the CLI and the GitHub Action consume it at
# runtime with no `npm install`. Only node_modules/ and build/ stay ignored.
!dist/
dist/*.map

# ==========================
# Temp Files
# ==========================
*.tmp
.tmp/
*.bak
*.orig
*.log

# ==========================
# Rendered Diagrams (PlantUML → PNG)
# ==========================
_rendered/

# ==========================
# Secrets / Credentials
# ==========================
.env
.env.*
*.pem
*.key
*.pfx
*.p12
id_rsa
id_ed25519

# ==========================
# Pricing / Proposal / Sensitive Docs
# (Never commit pricing documents, quotations, or vendor pricing.)
# ==========================
**/Proposal/
**/Pricing*/
**/vendor/
**/*Pricing*.xlsx
**/*Pricing*.md
**/*Proposal*.pdf
**/*Proposal*.xlsx
**/*Quotation*.xlsx
**/*Quotation*.pdf

# Test fixture exception: synthetic 29-byte placeholder, not a real spreadsheet.
# The sensitive-source fixture must ship this file so CI checkouts can prove
# SENSITIVE-001 fires on user-owned source without blocking release (PI-001).
!tests/fixtures/valid-source-others-and-sensitive/source/Quotation.xlsx

# ==========================
# Playwright MCP (temp snapshots)
# ==========================
.playwright-mcp/

# ==========================
# FreeBuff AI (local app state — SQLite session database)
# ==========================
.freebuff/

# ==========================
# Local-only, never committed (real private-hygiene denylist, per-machine
# scratch files). See pmo-config/private-hygiene-patterns.example.json.
# ==========================
.local/

# ==========================
# Internal (API Keys, Credentials, Sensitive Data)
# ==========================
Internal/

# Project-specific sensitive folders
P*/confidential/
P*/confidenciacal/

# ==========================
# Slide Deck — generated backups (safe to delete, regenerated on export)
# ==========================
Slide Deck/**/backup/

# ==========================
# Milestone 9: Failure Pattern Registry raw events -- local, opt-in (DEC-013,
# DEC-015). Ignored by default because raw diagnostic events are per-run
# local observations, not something committing by default should push into
# shared history without anyone choosing to. Sharing is explicit: commit
# .axiom/learning/FAILURE-PATTERNS.json (the derived, rebuildable registry)
# instead, if a team wants that shared.
# ==========================
.axiom/learning/events/
.axiom/learning/salt
