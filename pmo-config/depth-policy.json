      "data_constraint": ["happy", "negative"],
      "api_operation": ["happy", "negative", "security"],
      "state_transition": ["happy", "negative", "recovery"],
      "journey_step": ["happy"],
      "strict_trigger": ["security", "negative"]
    }
  },
  "srs_sections": [
